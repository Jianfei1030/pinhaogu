# Telegram Bot 配置
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_PROXY=  # 如 http://127.0.0.1:7890，留空则不使用代理

# QQ Bot 配置
QQ_TARGET=

# LLM API Key (阿里百炼/通义千问)
BAILIAN_API_KEY=

# LLM 模型与端点（可选，覆盖 config.yaml 默认值）
# LLM_MODEL=qwen-plus
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Ollama 地址（用于新闻 embedding 去重，默认 http://localhost:11434）
# OLLAMA_HOST=http://localhost:13145
